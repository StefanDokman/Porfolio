/*.mp4
  Cache-Control: public, max-age=31536000, immutable

# Covers /posters/*.webp too (a separate /posters/* rule sent the header twice).
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# The site is deployed as a Worker, so its *.workers.dev address (and preview URLs)
# duplicates the site; keep it out of search.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
